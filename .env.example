# --- Plantilla ---------------------------------------------------------------
# Vacio: demo de portafolio con todas las plantillas y el selector flotante.
#        Se puede enlazar una plantilla directa con /?plantilla=lumiere
# Con valor: instalacion de un cliente fijada en esa plantilla (ambar, lumiere...).
#        Se oculta el selector de demo y los textos de "proyecto de demostracion".
VITE_PLANTILLA=

# --- Datos -------------------------------------------------------------------
# Vacias: modo demo (los datos viven en el navegador con localStorage).
# Con los datos del proyecto Supabase del cliente: modo produccion.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
